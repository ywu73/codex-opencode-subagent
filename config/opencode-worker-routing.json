    },
    "deep_reasoning": {
      "agent_type": "opencode_worker_pro",
      "model": "deepseek-v4-pro",
      "model_provider": "opencode_go",
      "base_url": "https://opencode.ai/zen/go/v1",
      "wire_api": "responses",
      "model_context_window": 1000000,
      "strengths": ["deep-reasoning", "complex-analysis", "architecture-review"],
      "avoid": ["latency-sensitive-bulk-reading"],
      "cost_class": "medium",
      "status": "available",
      "validation": {
        "protocol": "verified",
        "provider_responses_probe": "verified",
        "live_smoke": "verified"
      }
