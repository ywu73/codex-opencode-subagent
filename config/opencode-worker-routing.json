    "explicit_profile",
    "explicit_agent_type",
    "explicit_model",
    "task_profile",
    "default_profile"
  ],
  "aliases": {
    "default": "fast_read",
    "flash": "fast_read",
    "pro": "deep_reasoning",
    "deep": "deep_reasoning"
  },
