{
  "version": 1,
  "default_profile": "fast_read",
  "selection_order": [
    "explicit_profile",
    "explicit_agent_type",
    "explicit_model",
    "task_profile",
    "default_profile"
  ],
  "aliases": {
    "default": "fast_read",
    "flash": "fast_read",
    "pro": "deep_reasoning",
    "deep": "deep_reasoning",
    "glm": "alternative_reasoning",
    "kimi": "code"
  },
  "task_profiles": {
    "bulk_reading": "fast_read",
    "deep_reasoning": "deep_reasoning",
    "alternative_reasoning": "alternative_reasoning",
    "code": "code"
  },
  "workers": {
    "fast_read": {
      "agent_type": "opencode_worker",
      "model": "deepseek-v4-flash",
      "model_provider": "opencode_go",
      "base_url": "https://opencode.ai/zen/go/v1",
      "wire_api": "responses",
      "strengths": ["fast", "bulk-reading", "extraction", "enumeration"],
      "avoid": ["deep-architecture-decisions"],
      "cost_class": "low",
      "status": "available",
      "validation": {
        "protocol": "verified",
        "live_smoke": "verified"
      }
    },
    "deep_reasoning": {
      "agent_type": "opencode_worker_pro",
      "model": "deepseek-v4-pro",
      "model_provider": "opencode_go",
      "base_url": "https://opencode.ai/zen/go/v1",
      "wire_api": "responses",
      "strengths": ["deep-reasoning", "complex-analysis", "architecture-review"],
      "avoid": ["latency-sensitive-bulk-reading"],
      "cost_class": "medium",
      "status": "available",
      "validation": {
        "protocol": "verified",
        "live_smoke": "not-run"
      }
    },
    "alternative_reasoning": {
      "agent_type": "opencode_worker_glm",
      "model": "glm-5.2",
      "model_provider": "opencode_go",
      "base_url": "https://opencode.ai/zen/go/v1",
      "wire_api": "responses",
      "strengths": ["alternative-reasoning", "independent-review", "comparison"],
      "avoid": ["unverified-provider-specific-assumptions"],
      "cost_class": "medium",
      "status": "available",
      "validation": {
        "protocol": "verified",
        "live_smoke": "not-run"
      }
    },
    "code": {
      "agent_type": "opencode_worker_kimi",
      "model": "kimi-k2.7-code",
      "model_provider": "opencode_go",
      "base_url": "https://opencode.ai/zen/go/v1",
      "wire_api": "responses",
      "strengths": ["code", "repository-analysis", "implementation-reading"],
      "avoid": ["unverified-domain-judgments"],
      "cost_class": "medium",
      "status": "available",
      "validation": {
        "protocol": "verified",
        "live_smoke": "not-run"
      }
    }
  }
}
