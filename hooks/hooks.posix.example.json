{
  "description": "One-shot plaintext task handoff for the OpenCode-backed DeepSeek workers.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(opencode_worker_ds_flash_v4|opencode_worker_ds_pro_v4)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/plaintext_handoff.py\" --mode hook",
            "timeout": 10,
            "statusMessage": "Delivering the staged OpenCode assignment",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
