{
  "description": "One-shot plaintext task handoff for the OpenCode-backed opencode_worker.",
  "hooks": {
    "SubagentStart": [
      {
        "matcher": "^(opencode_worker|opencode_worker_pro|opencode_worker_glm|opencode_worker_kimi)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"/absolute/path/to/plaintext_handoff.py\" --mode hook",
            "timeout": 10,
            "statusMessage": "Delivering the staged OpenCode assignment",
            "additionalContextLimit": 0
          }
        ]
      }
    ]
  }
}
